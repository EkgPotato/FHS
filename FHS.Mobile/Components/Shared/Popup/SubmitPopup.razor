@using FHS.Mobile.Components.Presentation
@using FHS.Mobile.Components.Shared.Button
<ActionPopup Open="@Open">
    <PopupContent>
        @SubmitPopupContent
    </PopupContent>
    <ActionContent>
        <div class="popup-actions">
            <CancelButton OnClick="OnCancel"
                          Class="cancel-button" />
            <SubmitButton OnClick="OnSubmit"
                          Class="submit-button"
                          Disabled="SubmitButtonDisabled" />
        </div>
    </ActionContent>
</ActionPopup>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool SubmitButtonDisabled { get; set; } = false;
    [Parameter] public RenderFragment? SubmitPopupContent { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
}

<style scoped>
    .popup-actions {
        display: flex;
        justify-content: space-between
    }

    .cancel-button {
        float: left;
    }

    .submit-button {
        float: right;
    }
</style>
