@using FHS.Mobile.Components.Presentation
@inherits BaseButton

@{
    base.BuildRenderTree(__builder);
}

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        base.Color = Color.Primary;
        base.Text = @Strings.Submit;
        base.Icon = @Icons.Material.Filled.Done;
    }
}
