@using FHS.Mobile.Components.Presentation
@inherits BaseButton

@{
    base.BuildRenderTree(__builder);
}

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        base.Color = Color.Error;
        base.Text = AppStrings.Cancel;
        base.Icon = @Icons.Material.Filled.Cancel;
    }
}
