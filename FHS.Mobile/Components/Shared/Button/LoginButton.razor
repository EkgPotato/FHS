@using FHS.Mobile.Components.Presentation
@inherits BaseButton

@{
    base.BuildRenderTree(__builder);
}

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        base.Color = Color.Primary;
        base.Text = AppStrings.Login;
        base.Class = "login-button";
    }
}

<style scoped> 
    .login-button {
        height: 3rem;
        width: 40%;
        margin: auto;
        font-size: 1rem;
        background-color: @MainTheme.SecondaryLightColor !important;
        color: @MainTheme.PrimaryDarkColor !important;
    }
</style>
