@using FHS.Mobile.Components.Presentation
<div class="expandable-fab-container">
    <MudFab StartIcon="@mainFabIcon"
            IconSize="Size.Large"
            Size="Size.Large"
            Class="@mainFabClass"
            Color="mainFabColor"
            @onclick="ToggleExpand" />

    <div class="action-fabs @ActionFabsClass">
        <MudButton Variant="Variant.Filled"
                   EndIcon="@Icons.Material.Filled.MoneyOff"
                   Style="@($"background-color: {MainTheme.ExpenseColor}")"
                   Class="action-fab">
            @AppStrings.Expense
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   EndIcon="@Icons.Material.Filled.AttachMoney"
                   Style="@($"background-color: {MainTheme.IncomeColor}")"
                   Class="action-fab">
            @AppStrings.Income
        </MudButton>
    </div>
</div>

@code {
    private string mainFabIcon { get; set; } = Icons.Material.Filled.Add;
    private Color mainFabColor { get; set; } = Color.Primary;
    private bool _isExpanded { get; set; } = false;
    private string mainFabClass => _isExpanded ? "main-fab expanded" : "main-fab";
    private string ActionFabsClass => _isExpanded ? "visible" : "hidden";
    private void ToggleExpand()
    {
        _isExpanded = !_isExpanded;

        if (_isExpanded)
        {
            mainFabIcon = Icons.Material.Filled.Close;
            mainFabColor = Color.Secondary;
        }
        else
        {
            mainFabIcon = Icons.Material.Filled.Add;
            mainFabColor = Color.Primary;
        }
    }
}

<style scoped>
    .expandable-fab-container {
        position: fixed;
        bottom: 2em;
        right: 2em;
        display: flex;
        flex-direction: column-reverse;
        z-index: 1000;
    }

    .main-fab {
        border-radius: 50%;
        width: 5em;
        float: right;
        margin-left: auto;
        height: 5em;
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

        .main-fab.expanded {
            transform: rotate(90deg);
        }

    .action-fabs {
        margin-bottom: 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        opacity: 0;
        transform: scale(0.9);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

        .action-fabs.visible {
            opacity: 1;
            transform: scale(1);
        }

        .action-fabs.hidden {
            opacity: 0;
            transform: scale(0.9);
        }

    .action-fab {
        width: 10em;
        height: 4em;
        transition: transform 0.2s ease;
    }

        .action-fab:hover {
            transform: scale(1.1);
        }
</style>
