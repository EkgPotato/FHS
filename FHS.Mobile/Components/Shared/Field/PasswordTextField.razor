@using FHS.Mobile.Components.Presentation
<MudTextField Typo="Typo.h5"
              Margin="Margin.Dense"
              Variant="Variant.Outlined"
              @bind-Value="Password"
              InputType="@PasswordInput"
              AdornmentIcon="@PasswordInputIcon"
              Adornment="Adornment.End"
              Class="text-field"
              OnAdornmentClick="ButtonTestclick" />

@code {
    [Parameter] public string Password { get; set; }
    private bool isShow;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private InputType PasswordInput = InputType.Password;

    void ButtonTestclick()
    {
        isShow = !isShow;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
        PasswordInputIcon = isShow ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    }
}

<style scoped>
    .text-field {
        color: @MainTheme.PrimaryDarkColor !important;
        background-color: @MainTheme.SecondaryLightColor !important;
        border-radius: 5%;
    }

</style>
