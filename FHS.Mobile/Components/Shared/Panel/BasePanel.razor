@using FHS.Mobile.Components.Presentation
<MudPaper Elevation="5"
Width="100"
Height="30"
Class="@Class">
    @ChildContent
</MudPaper>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; } = "panel-container";
}

<style scoped>
    .panel-container {
        margin: 0.2em;
        padding: 1em;
        width: 100%;
        background-color: @MainTheme.SecondaryLightColor !important;
    }
</style>
