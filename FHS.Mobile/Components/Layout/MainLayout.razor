@using FHS.Mobile.Components.Presentation
@inherits LayoutComponentBase
<MudThemeProvider Theme="MainTheme.GetMainTheme()"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="main">
    <MudPaper Elevation="25" Class="main-toolbar-container" >
        <MudToolBar>
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" Class="main-toolbar-item" />
        </MudToolBar>
    </MudPaper>
    @Body

</div>

<style scoped>
    .main-toolbar-container {
        margin: 0.3em;
        background-color: @MainTheme.PrimaryCol !important;
    }

    .main-toolbar-item {
        color: @MainTheme.ContrastColor !important
    }

</style>
