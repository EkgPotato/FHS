@using FHS.Mobile.Components.Presentation
@using FHS.Mobile.Interfaces
@inherits LayoutComponentBase
@inject IAuthService _authService

<MudThemeProvider Theme="MainTheme.GetMainTheme()" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


@if (_authService.IsAuthenticated)
{
    <MudPaper Elevation="25" Class="main-toolbar-container">
        <MudToolBar>
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" Class="main-toolbar-item" />
        </MudToolBar>
    </MudPaper>
    @Body
}
else
{
    @Body
}

<style scoped>
    .main-toolbar-container {
        margin: 0.3em;
        background-color: @MainTheme.PrimaryCol !important;
    }

    .main-toolbar-item {
        color: @MainTheme.PrimaryLightColor !important
    }

</style>
